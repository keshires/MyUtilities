# EDFX Utilities — PROD environment.
# Copy to ".env" and fill in real values. ".env" is gitignored — never commit it.
#
# This is the configuration for production. Use this for:
#   - Monthly stale entity refresh (refresh_stale_non_public_entities.py)
#   - PD precheck and validation scripts
#   - Process status checks (EDFX_ProcessStatus.py)
#   - Portfolio KPI reports against prod Postgres
#
# For non-prod environments see:
#   .env.ci.example   — CI
#   .env.qa.example   — QA  (read-only KPI reports)
#   .env.stg.example  — STG (read-only KPI reports)

# --- Tessera Postgres (PROD) ---
# Used by: export_stale_entities_from_excel.py, refresh_stale_non_public_entities.py,
#          validate_stale_entities.py, validate_stale_pd_source.py, validate_pd_precheck.py,
#          run_portfolio_kpis_postgres.py, portfolio_kpi_metrics_postgres.py
TESSERA_POSTGRES_HOST=
TESSERA_POSTGRES_PORT=5432
TESSERA_POSTGRES_DB=
TESSERA_POSTGRES_USER=
TESSERA_POSTGRES_PASSWORD=

# --- Tessera API (PROD) ---
# Used by: refresh_stale_non_public_entities.py, validate_stale_pd_source.py,
#          validate_pd_precheck.py, EDFX_ProcessStatus.py
TESSERA_BASE_URL=https://api.edfx.moodysanalytics.com
MOODYS_SSO_URL=https://sso.moodysanalytics.com/sso-api/v1/token
MOODYS_SSO_USERNAME=
MOODYS_SSO_PASSWORD=

# --- Stale entity refresh tuning (optional overrides) ---
# STALE_REFRESH_BATCH_SIZE=15000
# STALE_REFRESH_WORKERS=3
# STALE_REFRESH_ENTITY_TYPE=private
# STALE_REFRESH_EXCLUDED_TENANTS=001aJ00000Cwqc2QAB   # deprecated tenant — exclude from refresh

# --- EDFX Process Status (EDFX_ProcessStatus.py) ---
EDFX_BASE_URL=https://api.edfx.moodysanalytics.com/edfx/v1/processes
# EDFX_OUTPUT_FOLDER=          # default: output/edfx_process_status/
# EDFX_MANUAL_TOKEN=           # set to skip SSO (short-lived; use SSO creds instead)

# --- Financials API (financials_delete_custom_entity.py) ---
# EDFX_TOKEN=                  # bearer token — never commit; short-lived
# EDFX_DELETE_ENTITY_IDS=      # comma-separated UUIDs (optional; prefer --entity-id CLI flag)

# --- OpenSearch query builder (build_opensearch_entity_query_from_csv.py) ---
# OPENSEARCH_TENANT_ID=        # default tenant; CLI --tenant-id wins

# --- Portfolio KPI reports (run_portfolio_kpis_postgres.py, portfolio_kpi_metrics_postgres.py) ---
# KPI_FUNCTION_SCHEMA=public
# PORTFOLIO_TABLE=portfolio
# PORTFOLIO_ID_COLUMN=portfolio_id
