# Day2Day Utilities — copy to ".env" in the project root and fill in real values.
# Never commit ".env" — it is gitignored.
#
# Path layout (project root):
#   logs/              — runtime logs (run_portfolio_kpis_postgres.py; KPI_LOG_FILE relative to root)
#   output/run_portfolio_kpis/  — --export-list CSVs (relative paths)
#   output/export_stale_entities/ — export_stale_entities_from_excel.py (default + relative --output)
#   output/build_opensearch_query/ — build_opensearch_entity_query_from_csv.py (relative --output-dir, --out, --queries-out)
# EDFX_OUTPUT_FOLDER: use absolute paths, or paths relative to the project root.

# --- Tessera Postgres (export_stale_entities_from_excel.py, run_portfolio_kpis_postgres.py, portfolio_kpi_metrics_postgres.py)
TESSERA_POSTGRES_HOST=
TESSERA_POSTGRES_PORT=5432
TESSERA_POSTGRES_DB=
TESSERA_POSTGRES_USER=
TESSERA_POSTGRES_PASSWORD=

# Optional: run_portfolio_kpis_postgres.py
# KPI_FUNCTION_SCHEMA=public
# PORTFOLIO_TABLE=portfolio
# PORTFOLIO_ID_COLUMN=portfolio_id

# --- Stale entity refresh (refresh_stale_non_public_entities.py)
# Uses TESSERA_POSTGRES_* above. Date filter defaults to first day of current month.
TESSERA_BASE_URL=https://api.edfx.moodysanalytics.com
# Optional alias (typo): TESSEARA_BASE_URL=
# STALE_REFRESH_BATCH_SIZE=15000
# STALE_REFRESH_WORKERS=3
# STALE_REFRESH_ENTITY_TYPE=private
# STALE_REFRESH_ENTITY_TYPE=custom
# STALE_REFRESH_EXCLUDED_TENANTS=0014000000NXtS8
# STALE_REFRESH_MANUAL_TOKEN=

# --- EDFX Process Status (EDFX_ProcessStatus.py)
# Uses TESSERA_POSTGRES_* above to load process IDs from entity_custom_data.
MOODYS_SSO_URL=https://sso.moodysanalytics.com/sso-api/v1/token
MOODYS_SSO_USERNAME=
MOODYS_SSO_PASSWORD=
EDFX_BASE_URL=https://api.edfx.moodysanalytics.com/edfx/v1/processes
# Optional; default is output/edfx_process_status/ under project root
EDFX_OUTPUT_FOLDER=
# Optional: override default query (must return financials_process_id)
# EDFX_PROCESS_QUERY=SELECT DISTINCT financials_process_id, financials_process_status FROM entity_custom_data WHERE financials_process_status <> 'Completed'
# Optional: skip SSO if set
# EDFX_MANUAL_TOKEN=

# --- EDFX Financials API (financials_delete_custom_entity.py)
# Bearer token (never commit; use .env + VS Code envFile — not launch.json args)
# EDFX_TOKEN=
# Comma-separated entity UUIDs if you omit --entity-id (e.g. for F5 debug)
# EDFX_DELETE_ENTITY_IDS=id1,id2
# Optional Cloudflare / session cookie
# EDFX_COOKIE=

# Default tenant for build_opensearch_entity_query_from_csv.py (optional; CLI --tenant-id wins)
# OPENSEARCH_TENANT_ID=0014000000YOURWORKSPACEORG
