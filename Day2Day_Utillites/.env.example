# Day2Day Utilities — copy to ".env" in the project root and fill in real values.
# Never commit ".env" — it is gitignored.
#
# Path layout (project root):
#   logs/              — runtime logs (run_portfolio_kpis_postgres.py; KPI_LOG_FILE relative to root)
#   output/portfolio/  — --export-list CSVs (relative paths)
#   output/stale_entities/ — export_stale_entities_from_excel.py (default + relative --output)
#   output/opensearch_queries/ — build_opensearch_entity_query_from_csv.py (relative --output-dir, --out, --queries-out)
# EDFX_INPUT_FOLDER / EDFX_OUTPUT_FOLDER / LC_BATCH_ROOT_FOLDER / LGD_UPLOAD_FILE_PATH:
#   use absolute paths, or paths relative to the project root.

# --- Tessera Postgres (export_stale_entities_from_excel.py, run_portfolio_kpis_postgres.py, portfolio_kpi_metrics_postgres.py)
TESSERA_POSTGRES_HOST=
TESSERA_POSTGRES_PORT=5432
TESSERA_POSTGRES_DB=
TESSERA_POSTGRES_USER=
TESSERA_POSTGRES_PASSWORD=

# Optional: run_portfolio_kpis_postgres.py
# KPI_FUNCTION_SCHEMA=public
# PORTFOLIO_TABLE=portfolio
# PORTFOLIO_ID_COLUMN=portfolio_id

# --- EDFX Process Status (EDFX_ProcessStatus.py)
MOODYS_SSO_URL=https://sso.moodysanalytics.com/sso-api/v1/token
MOODYS_SSO_USERNAME=
MOODYS_SSO_PASSWORD=
EDFX_BASE_URL=https://api.edfx.moodysanalytics.com/edfx/v1/processes
EDFX_INPUT_FOLDER=
EDFX_OUTPUT_FOLDER=
# Optional: skip SSO if set
# EDFX_MANUAL_TOKEN=

# --- EDFX Financials API (financials_delete_custom_entity.py)
# Bearer token (never commit; use .env + VS Code envFile — not launch.json args)
# EDFX_TOKEN=
# Comma-separated entity UUIDs if you omit --entity-id (e.g. for F5 debug)
# EDFX_DELETE_ENTITY_IDS=id1,id2
# Optional Cloudflare / session cookie
# EDFX_COOKIE=

# Default tenant for build_opensearch_entity_query_from_csv.py (optional; CLI --tenant-id wins)
# OPENSEARCH_TENANT_ID=0014000000YOURWORKSPACEORG

# --- LGD batch load test (LDGLoadTest.py)
# LGD_RUN_ENV=qa
LGD_BATCH_USERNAME_PROD=
LGD_BATCH_PASSWORD_PROD=
LGD_BATCH_USERNAME_QA=
LGD_BATCH_PASSWORD_QA=
LGD_UPLOAD_FILE_PATH=
LGD_UPLOAD_FILE_NAME=
# LGD_STATUS_REQUEST_COUNT=500

# --- RiskCalc SOAP — SecurityService.py (AuthenticateAndGetUserInfo)
RISKCALC_SECURITY_SOAP_URL=https://api-security.riskcalc.moodysanalytics.com/services/security/internal/Security.svc
RISKCALC_WSSE_USERNAME=
RISKCALC_WSSE_PASSWORD=
RISKCALC_SOAP_NONCE=
RISKCALC_SOAP_CREATED=
RISKCALC_AUTH_BODY_USERNAME=
RISKCALC_AUTH_BODY_PASSWORD=

# --- RiskCalc SOAP — Sample_RCTest.py (GetUserSignedLicensingDocumentXml)
RISKCALC_LICENSE_DOCUMENT_USERNAME=
# Comma-separated integers, e.g. 5
RISKCALC_LICENSE_PRODUCT_IDS=5

# --- RiskCalc REST — SampleTest.py
RISKCALC_REST_URL=https://qa-api.riskcalc.moodysanalytics.net/services/internal/RiskCalcRestService.svc
RISKCALC_REST_SESSION_COOKIE=
RISKCALC_REST_PASSWORD=

# --- LC_Process.py example (optional)
# LC_BATCH_ROOT_FOLDER=\\\\fileserver\\share\\LC-BatchDataFiles
